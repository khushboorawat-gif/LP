<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ 'timkolas.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="container narrow center" style="padding-block:96px">
    <h1 class="logo-text">{{ shop.name | upcase }}</h1>
    <p class="lead">{{ shop.password_message | default: 'This store is not open yet.' }}</p>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <label for="Password">Enter store password</label>
      <input type="password" name="password" id="Password" class="input">
      <button type="submit" class="btn btn-primary" style="margin-top:12px">Enter</button>
    {% endform %}
  </main>
  {{ content_for_layout }}
</body>
</html>
