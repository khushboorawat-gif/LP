<section class="section">
  <div class="container">
    <div class="toolbar">
      <h2 style="margin:0">{{ section.settings.heading }}</h2>
      {%- if section.settings.collection != blank %}<a class="btn btn-outline" href="{{ section.settings.collection.url }}">View all</a>{% endif -%}
    </div>
    {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
      <div class="grid grid-4">
        {%- for product in section.settings.collection.products limit: section.settings.count -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="lead">Choose a collection in the theme editor. Products appear here once they are published.</p>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the range" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
