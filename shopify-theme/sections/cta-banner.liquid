<section class="section" style="padding-bottom:0">
  <div class="container">
    <div class="toolbar" style="padding:36px;border-radius:24px;border:1px solid var(--line);margin:0">
      <div style="flex:1 1 380px">
        <h2 style="margin-bottom:8px">{{ section.settings.heading }}</h2>
        <p style="margin:0;color:var(--muted)">{{ section.settings.text }}</p>
      </div>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        {%- if section.settings.cta_label != blank %}<a class="btn btn-primary" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>{% endif -%}
        {%- if section.settings.cta2_label != blank %}<a class="btn btn-outline" href="{{ section.settings.cta2_link }}">{{ section.settings.cta2_label }}</a>{% endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Call to action banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure which one to buy?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Compare two or three consoles side by side, or read our short guide." },
    { "type": "text", "id": "cta_label", "label": "Button 1 label", "default": "Compare consoles" },
    { "type": "url", "id": "cta_link", "label": "Button 1 link" },
    { "type": "text", "id": "cta2_label", "label": "Button 2 label", "default": "Read the guide" },
    { "type": "url", "id": "cta2_link", "label": "Button 2 link" }
  ],
  "presets": [{ "name": "Call to action banner" }]
}
{% endschema %}
