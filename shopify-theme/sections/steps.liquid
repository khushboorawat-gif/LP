<section class="section section-dark">
  <div class="container">
    <h2>{{ section.settings.heading }}</h2>
    <div class="grid grid-3" style="margin-top:28px">
      {%- for block in section.blocks -%}
        <div class="step" {{ block.shopify_attributes }}>
          <div class="n">{{ forloop.index }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank %}<p style="margin-top:20px;font-size:14px;color:#9AA7C7">{{ section.settings.note }}</p>{% endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Setup steps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Set up in three steps" },
    { "type": "text", "id": "note", "label": "Footnote", "default": "Exact setup differs by model. See each product page for what is in the box." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Connect" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Plug the console into your TV's HDMI port and power it." }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Setup steps" }]
}
{% endschema %}
