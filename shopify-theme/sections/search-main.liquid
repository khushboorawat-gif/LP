{%- paginate search.results by 12 -%}
<section class="section">
  <div class="container">
    <h1>Search</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" style="margin-bottom:24px;max-width:520px">
      <label for="page-search" class="visually-hidden">Search products</label>
      <input id="page-search" class="input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search consoles" style="width:100%">
      <input type="hidden" name="type" value="product">
    </form>
    {%- if search.performed -%}
      <p>{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for "{{ search.terms | escape }}"</p>
      {%- if search.results_count > 0 -%}
        <div class="grid grid-4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
      {%- else -%}
        <p class="lead">No products found. Try a shorter search or browse the <a href="{{ routes.all_products_collection_url }}" style="text-decoration:underline">full range</a>.</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Search" }
{% endschema %}
